<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Dashboard</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link active">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Visao Geral</p>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Bem-vindo de volta, <%= locals.utilizador ? locals.utilizador.nome : 'Utilizador' %>.</p>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi-card blue">
        <div class="kpi-top">
          <div class="kpi-icon blue"></div>
          <span class="kpi-badge neutral">0%</span>
        </div>
        <p class="kpi-label">Total de Associados</p>
        <p class="kpi-value"><%= typeof totalAssociados !== 'undefined' ? totalAssociados : 0 %></p>
        <p class="kpi-context">Nenhum registo este mes</p>
      </div>
      <div class="kpi-card teal">
        <div class="kpi-top">
          <div class="kpi-icon teal"></div>
          <span class="kpi-badge neutral">0%</span>
        </div>
        <p class="kpi-label">Quotas Pagas</p>
        <p class="kpi-value"><%= typeof totalQuotas !== 'undefined' ? totalQuotas : 0 %></p>
        <p class="kpi-context">Sem pagamentos registados</p>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-top">
          <div class="kpi-icon amber"></div>
          <span class="kpi-badge neutral">0%</span>
        </div>
        <p class="kpi-label">Atividades</p>
        <p class="kpi-value"><%= typeof totalAtividades !== 'undefined' ? totalAtividades : 0 %></p>
        <p class="kpi-context">Nenhuma atividade agendada</p>
      </div>
      <div class="kpi-card maroon">
        <div class="kpi-top">
          <div class="kpi-icon maroon"></div>
          <span class="kpi-badge info"><%= typeof totalUtilizadores !== 'undefined' ? totalUtilizadores : 0 %> ativos</span>
        </div>
        <p class="kpi-label">Utilizadores</p>
        <p class="kpi-value"><%= typeof totalUtilizadores !== 'undefined' ? totalUtilizadores : 0 %></p>
        <p class="kpi-context">Todos com acesso atribuido</p>
      </div>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
      <h2 class="card-title">Acesso Rapido</h2>
      <span style="font-size:12.5px; color:var(--clr-muted);">Atalhos para as areas principais</span>
    </div>
    <div class="quick-links">
      <a href="/associados" class="quick-link">
        <div class="quick-link-icon" style="background:#EFF6FF; color:#3B82F6;"></div>
        <div class="quick-link-text">
          <strong>Gestao de Associados</strong>
          <span>Ver e gerir associados</span>
        </div>
        <div class="quick-link-arrow">→</div>
      </a>
      <a href="/financeiro" class="quick-link">
        <div class="quick-link-icon" style="background:#ECFDF5; color:#2E7D5B;"></div>
        <div class="quick-link-text">
          <strong>Controlo Financeiro</strong>
          <span>Recibos e pagamentos</span>
        </div>
        <div class="quick-link-arrow">→</div>
      </a>
      <a href="/quotas" class="quick-link">
        <div class="quick-link-icon" style="background:#FFFBEB; color:#D97706;"></div>
        <div class="quick-link-text">
          <strong>Gestao de Quotas</strong>
          <span>Ver e gerir quotas</span>
        </div>
        <div class="quick-link-arrow">→</div>
      </a>
      <a href="/atividades" class="quick-link">
        <div class="quick-link-icon" style="background:#FFFBEB; color:#D97706;"></div>
        <div class="quick-link-text">
          <strong>Gestao de Atividades</strong>
          <span>Ver e gerir atividades</span>
        </div>
        <div class="quick-link-arrow">→</div>
      </a>
      <a href="/utilizadores" class="quick-link">
        <div class="quick-link-icon" style="background:#FFF1F2; color:#7A1F2B;"></div>
        <div class="quick-link-text">
          <strong>Gestao de Utilizadores</strong>
          <span>Ver e gerir utilizadores</span>
        </div>
        <div class="quick-link-arrow">→</div>
      </a>
    </div>
  </main>
</body>
</html>
