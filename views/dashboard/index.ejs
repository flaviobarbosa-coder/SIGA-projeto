<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    body { background-color: #f5f5f5; }
    .card-kpi { border-left: 4px solid #8B0000; border-radius: 8px; }
    .card-kpi:hover { transform: translateY(-3px); transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    .kpi-icon { font-size: 2.5rem; }
    .sidebar { background-color: #8B0000; min-height: 100vh; padding-top: 20px; }
    .sidebar a { color: white; text-decoration: none; display: block; padding: 12px 20px; border-radius: 8px; margin: 4px 10px; }
    .sidebar a:hover { background-color: rgba(255,255,255,0.2); }
    .sidebar a.active { background-color: rgba(255,255,255,0.3); }
    .main-content { padding: 30px; }
    .logo-area { text-align: center; padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.2); margin-bottom: 20px; }
    .logo-text { color: white; font-size: 1.8rem; font-weight: bold; }
    .logo-sub { color: rgba(255,255,255,0.7); font-size: 0.8rem; }
  </style>
</head>
<body>
  <div class="d-flex">

    <!-- SIDEBAR -->
    <div class="sidebar" style="width: 250px; min-width: 250px;">
      <div class="logo-area">
        <div class="logo-text">🏛️ SIGA</div>
        <div class="logo-sub">Sistema de Gestão de Associados</div>
      </div>

      <% if (locals.utilizador) { %>
        <a href="/dashboard" class="active">📊 Dashboard</a>

        <% if (['admin','gestor_associados'].includes(locals.utilizador.perfil)) { %>
          <a href="/associados">🤝 Associados</a>
        <% } %>

        <% if (['admin','gestor_financeiro'].includes(locals.utilizador.perfil)) { %>
          <a href="/quotas">💰 Quotas</a>
          <a href="/financeiro">🧾 Financeiro</a>
        <% } %>

        <% if (['admin','gestor_atividades'].includes(locals.utilizador.perfil)) { %>
          <a href="/atividades">📅 Atividades</a>
        <% } %>

        <% if (['admin'].includes(locals.utilizador.perfil)) { %>
          <a href="/utilizadores">👥 Utilizadores</a>
        <% } %>

        <hr style="border-color: rgba(255,255,255,0.2);">
        <a href="/auth/logout">🚪 Sair</a>
      <% } %>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content w-100">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h3 class="mb-0">Dashboard</h3>
          <small class="text-muted">Bem-vindo, <%= locals.utilizador ? locals.utilizador.nome : '' %>!</small>
        </div>
        <div class="text-muted">
          <small>📅 <%= new Date().toLocaleDateString('pt-PT') %></small>
        </div>
      </div>

      <!-- KPIs -->
      <div class="row g-4 mb-4">
        <div class="col-md-3">
          <div class="card card-kpi p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Total Associados</div>
                <div class="fs-3 fw-bold text-danger"><%= totalAssociados || 0 %></div>
              </div>
              <div class="kpi-icon">🤝</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card card-kpi p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Quotas Pagas</div>
                <div class="fs-3 fw-bold text-success"><%= quotasPagas || 0 %></div>
              </div>
              <div class="kpi-icon">💰</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card card-kpi p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Atividades</div>
                <div class="fs-3 fw-bold text-primary"><%= totalAtividades || 0 %></div>
              </div>
              <div class="kpi-icon">📅</div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card card-kpi p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Utilizadores</div>
                <div class="fs-3 fw-bold text-warning"><%= totalUtilizadores || 0 %></div>
              </div>
              <div class="kpi-icon">👥</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ACESSO RAPIDO -->
      <div class="row g-4">
        <div class="col-12">
          <h5 class="mb-3">Acesso Rápido</h5>
        </div>
        <% if (['admin','gestor_associados'].includes(locals.utilizador ? locals.utilizador.perfil : '')) { %>
          <div class="col-md-4">
            <div class="card p-3 text-center" style="cursor:pointer;" onclick="location.href='/associados'">
              <div style="font-size:2rem;">🤝</div>
              <div class="fw-bold mt-2">Gestão de Associados</div>
              <small class="text-muted">Ver e gerir associados</small>
            </div>
          </div>
        <% } %>
        <% if (['admin','gestor_financeiro'].includes(locals.utilizador ? locals.utilizador.perfil : '')) { %>
          <div class="col-md-4">
            <div class="card p-3 text-center" style="cursor:pointer;" onclick="location.href='/financeiro'">
              <div style="font-size:2rem;">🧾</div>
              <div class="fw-bold mt-2">Controlo Financeiro</div>
              <small class="text-muted">Recibos e pagamentos</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-3 text-center" style="cursor:pointer;" onclick="location.href='/quotas'">
              <div style="font-size:2rem;">💰</div>
              <div class="fw-bold mt-2">Gestão de Quotas</div>
              <small class="text-muted">Ver e gerir quotas</small>
            </div>
          </div>
        <% } %>
        <% if (['admin','gestor_atividades'].includes(locals.utilizador ? locals.utilizador.perfil : '')) { %>
          <div class="col-md-4">
            <div class="card p-3 text-center" style="cursor:pointer;" onclick="location.href='/atividades'">
              <div style="font-size:2rem;">📅</div>
              <div class="fw-bold mt-2">Gestão de Atividades</div>
              <small class="text-muted">Ver e gerir atividades</small>
            </div>
          </div>
        <% } %>
        <% if (['admin'].includes(locals.utilizador ? locals.utilizador.perfil : '')) { %>
          <div class="col-md-4">
            <div class="card p-3 text-center" style="cursor:pointer;" onclick="location.href='/utilizadores'">
              <div style="font-size:2rem;">👥</div>
              <div class="fw-bold mt-2">Gestão de Utilizadores</div>
              <small class="text-muted">Ver e gerir utilizadores</small>
            </div>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</body>
</html>
