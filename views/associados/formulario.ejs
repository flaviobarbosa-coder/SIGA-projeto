<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Nova Candidatura</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados/lista" class="nav-link active">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Associados</p>
        <h1 class="page-title">Nova Candidatura</h1>
        <p class="page-subtitle">Preencha os dados para submeter uma nova candidatura.</p>
      </div>
      <div class="page-header-actions">
        <a href="/associados/lista" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card" style="max-width:560px;">
      <div class="card-body">
        <% if (messages.error && messages.error.length > 0) { %>
          <div style="background:#FEF2F2; color:#B91C1C; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
            <%= messages.error %>
          </div>
        <% } %>
        <% if (messages.success && messages.success.length > 0) { %>
          <div style="background:#ECFDF5; color:#2E7D5B; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
            <%= messages.success %>
          </div>
        <% } %>
        <form action="/associados/submeter" method="POST">
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Nome Completo</label>
            <input type="text" name="nome" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Tipo</label>
            <select name="tipo" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; background:white;">
              <option value="fisica">Pessoa Fisica</option>
              <option value="juridica">Pessoa Juridica</option>
            </select>
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Email</label>
            <input type="email" name="email" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Telefone</label>
            <input type="text" name="telefone"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">NIF</label>
            <input type="text" name="nif"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:24px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Morada</label>
            <textarea name="morada" rows="3"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">
            Submeter Candidatura
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
