<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Detalhes do Associado</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
  <h2>Detalhes do Associado</h2>

  <div class="card mt-3">
    <div class="card-body">
      <h5 class="card-title"><%= associado.nome %></h5>
      <p><strong>Tipo:</strong> <%= associado.tipo %></p>
      <p><strong>Email:</strong> <%= associado.email %></p>
      <p><strong>Telefone:</strong> <%= associado.telefone || '-' %></p>
      <p><strong>NIF:</strong> <%= associado.nif || '-' %></p>
      <p><strong>Morada:</strong> <%= associado.morada || '-' %></p>
      <p><strong>Estado:</strong> 
        <span class="badge 
          <%= associado.estado === 'aprovada' ? 'bg-success' : 
              associado.estado === 'rejeitada' ? 'bg-danger' : 
              associado.estado === 'activo' ? 'bg-primary' : 'bg-warning' %>">
          <%= associado.estado %>
        </span>
      </p>
      <p><strong>Data de Candidatura:</strong> <%= associado.data_criacao %></p>
    </div>
  </div>

  <div class="mt-3">
    <form action="/associados/aprovar/<%= associado.id %>" method="POST" style="display:inline">
      <button class="btn btn-success">Aprovar</button>
    </form>
    <form action="/associados/rejeitar/<%= associado.id %>" method="POST" style="display:inline">
      <button class="btn btn-danger">Rejeitar</button>
    </form>
    <a href="/associados/lista" class="btn btn-secondary">Voltar à Lista</a>
  </div>
</div>
</body>
</html>