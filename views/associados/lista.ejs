<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Lista de Associados</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
  <h2>Lista de Associados</h2>
  <a href="/associados/formulario" class="btn btn-primary mb-3">Nova Candidatura</a>

  <table class="table table-bordered">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th>Tipo</th>
        <th>Email</th>
        <th>Telefone</th>
        <th>Estado</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (associados.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center">Nenhum associado encontrado.</td>
        </tr>
      <% } else { %>
        <% associados.forEach(a => { %>
          <tr>
            <td><%= a.id %></td>
            <td><%= a.nome %></td>
            <td><%= a.tipo %></td>
            <td><%= a.email %></td>
            <td><%= a.telefone || '-' %></td>
            <td>
              <span class="badge 
                <%= a.estado === 'aprovada' ? 'bg-success' : 
                    a.estado === 'rejeitada' ? 'bg-danger' : 
                    a.estado === 'activo' ? 'bg-primary' : 'bg-warning' %>">
                <%= a.estado %>
              </span>
            </td>
            <td>
              <a href="/associados/detalhes/<%= a.id %>" class="btn btn-sm btn-info">Ver</a>
              <form action="/associados/aprovar/<%= a.id %>" method="POST" style="display:inline">
                <button class="btn btn-sm btn-success">Aprovar</button>
              </form>
              <form action="/associados/rejeitar/<%= a.id %>" method="POST" style="display:inline">
                <button class="btn btn-sm btn-danger">Rejeitar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
</body>
</html>