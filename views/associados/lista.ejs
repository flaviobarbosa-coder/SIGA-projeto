<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Lista de Associados</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados/lista" class="nav-link active">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Gestao</p>
        <h1 class="page-title">Associados</h1>
        <p class="page-subtitle">Consulte e gira as candidaturas e associados.</p>
      </div>
      <div class="page-header-actions">
        <a href="/associados/formulario" class="btn btn-primary">+ Nova Candidatura</a>
      </div>
    </div>
    <% if (messages.success && messages.success.length > 0) { %>
      <div style="background:#ECFDF5; color:#2E7D5B; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
        <%= messages.success %>
      </div>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
      <div style="background:#FEF2F2; color:#B91C1C; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
        <%= messages.error %>
      </div>
    <% } %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Lista de Associados</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= associados.length %> registos</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Associado</th>
              <th>Tipo</th>
              <th>Telefone</th>
              <th>NIF</th>
              <th>Estado</th>
              <th>Acoes</th>
            </tr>
          </thead>
          <tbody>
            <% if (associados.length > 0) { %>
              <% associados.forEach(function(a) { %>
                <tr>
                  <td>
                    <div style="display:flex; align-items:center; gap:10px;">
                      <div class="avatar" style="background:var(--clr-maroon);">
                        <%= a.nome.charAt(0).toUpperCase() %>
                      </div>
                      <div>
                        <p style="font-weight:600; margin:0;"><%= a.nome %></p>
                        <p style="font-size:12px; color:var(--clr-muted); margin:0;"><%= a.email %></p>
                      </div>
                    </div>
                  </td>
                  <td><%= a.tipo %></td>
                  <td><%= a.telefone || '---' %></td>
                  <td><%= a.nif || '---' %></td>
                  <td>
                    <% if (a.estado === 'activo' || a.estado === 'aprovada') { %>
                      <span class="badge badge-green">Ativo</span>
                    <% } else if (a.estado === 'em_analise' || a.estado === 'submetida') { %>
                      <span class="badge badge-yellow">Em Analise</span>
                    <% } else if (a.estado === 'rejeitada') { %>
                      <span class="badge badge-red">Rejeitado</span>
                    <% } else { %>
                      <span class="badge badge-gray"><%= a.estado %></span>
                    <% } %>
                  </td>
                  <td style="display:flex; gap:6px;">
                    <a href="/associados/detalhes/<%= a.id %>" class="btn btn-outline" style="font-size:12px; padding:5px 12px;">Ver</a>
                    <% if (a.estado === 'submetida' || a.estado === 'em_analise') { %>
                      <form action="/associados/aprovar/<%= a.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-primary" style="font-size:12px; padding:5px 12px;">Aprovar</button>
                      </form>
                      <form action="/associados/rejeitar/<%= a.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-outline" style="font-size:12px; padding:5px 12px; color:#B91C1C; border-color:#B91C1C;">Rejeitar</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--clr-muted); padding:30px;">Nenhum associado registado</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
