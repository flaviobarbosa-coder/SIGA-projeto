<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Editar Utilizador</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link active">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Administracao</p>
        <h1 class="page-title">Editar Utilizador</h1>
        <p class="page-subtitle">Altere os dados do utilizador.</p>
      </div>
      <div class="page-header-actions">
        <a href="/utilizadores" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card" style="max-width:520px;">
      <div class="card-body">
        <% if (erro && erro.length > 0) { %>
          <div style="background:#FEF2F2; color:#B91C1C; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
            <%= erro %>
          </div>
        <% } %>
        <% if (sucesso && sucesso.length > 0) { %>
          <div style="background:#ECFDF5; color:#2E7D5B; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
            <%= sucesso %>
          </div>
        <% } %>
        <form action="/utilizadores/editar/<%= utilizador.id %>" method="POST">
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Nome</label>
            <input type="text" name="nome" value="<%= utilizador.nome %>" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Email</label>
            <input type="email" name="email" value="<%= utilizador.email %>" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Nova Password <span style="color:var(--clr-muted); font-weight:400;">(deixa vazio para manter)</span></label>
            <input type="password" name="password"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Perfil</label>
            <select name="perfil" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; background:white;">
              <option value="admin" <%= utilizador.perfil === 'admin' ? 'selected' : '' %>>Administrador</option>
              <option value="gestor_associados" <%= utilizador.perfil === 'gestor_associados' ? 'selected' : '' %>>Gestor de Associados</option>
              <option value="gestor_financeiro" <%= utilizador.perfil === 'gestor_financeiro' ? 'selected' : '' %>>Gestor Financeiro</option>
              <option value="gestor_atividades" <%= utilizador.perfil === 'gestor_atividades' ? 'selected' : '' %>>Gestor de Atividades</option>
              <option value="direcao" <%= utilizador.perfil === 'direcao' ? 'selected' : '' %>>Direcao</option>
              <option value="associado" <%= utilizador.perfil === 'associado' ? 'selected' : '' %>>Associado</option>
            </select>
          </div>
          <div style="margin-bottom:24px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Estado</label>
            <select name="estado" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; background:white;">
              <option value="ativo" <%= utilizador.estado === 'ativo' ? 'selected' : '' %>>Ativo</option>
              <option value="bloqueado" <%= utilizador.estado === 'bloqueado' ? 'selected' : '' %>>Bloqueado</option>
              <option value="inativo" <%= utilizador.estado === 'inativo' ? 'selected' : '' %>>Inativo</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">
            Guardar Alteracoes
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
