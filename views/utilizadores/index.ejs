<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Gestao de Utilizadores</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
  <style>
    .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link active">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Administracao</p>
        <h1 class="page-title">Utilizadores</h1>
        <p class="page-subtitle">Geste os acessos e permissoes da plataforma.</p>
      </div>
      <div class="page-header-actions">
        <a href="/utilizadores/criar" class="btn btn-primary">+ Novo Utilizador</a>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi-card maroon">
        <div class="kpi-top">
          <div class="kpi-icon maroon"></div>
          <span class="kpi-badge info"><%= utilizadores.length %> ativos</span>
        </div>
        <p class="kpi-label">Total de Utilizadores</p>
        <p class="kpi-value"><%= utilizadores.length %></p>
        <p class="kpi-context">Todos com acesso atribuido</p>
      </div>
      <div class="kpi-card blue">
        <div class="kpi-top">
          <div class="kpi-icon blue"></div>
          <span class="kpi-badge info">Hoje</span>
        </div>
        <p class="kpi-label">Utilizadores Ativos</p>
        <p class="kpi-value"><%= utilizadores.filter(u => u.estado === 'ativo').length %></p>
        <p class="kpi-context">Com acesso ativo</p>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-top">
          <div class="kpi-icon amber"></div>
          <span class="kpi-badge neutral">Pendentes</span>
        </div>
        <p class="kpi-label">Bloqueados</p>
        <p class="kpi-value"><%= utilizadores.filter(u => u.estado === 'bloqueado').length %></p>
        <p class="kpi-context">Requerem atencao</p>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Equipa</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= utilizadores.length %> utilizadores com acesso</span>
      </div>
      <div class="user-grid">
        <% utilizadores.forEach(function(u) { %>
          <div class="user-card">
            <div class="user-card-top">
              <div class="avatar" style="background:var(--clr-maroon);">
                <%= u.nome.charAt(0).toUpperCase() %><%= u.nome.split(' ')[1] ? u.nome.split(' ')[1].charAt(0).toUpperCase() : '' %>
              </div>
              <div class="user-card-info">
                <p class="user-card-name"><%= u.nome %></p>
                <p class="user-card-email"><%= u.email %></p>
              </div>
            </div>
            <div>
              <% if (u.estado === 'ativo') { %>
                <span class="badge badge-green"><%= u.perfil %></span>
              <% } else if (u.estado === 'bloqueado') { %>
                <span class="badge badge-red"><%= u.perfil %></span>
              <% } else { %>
                <span class="badge badge-gray"><%= u.perfil %></span>
              <% } %>
            </div>
            <div class="user-card-bottom">
              <span class="user-card-last">Estado: <%= u.estado %></span>
              <div style="display:flex; gap:6px;">
                <a href="/utilizadores/editar/<%= u.id %>" class="icon-btn">✏️</a>
                <a href="/utilizadores/eliminar/<%= u.id %>" class="icon-btn" onclick="return confirm('Tens a certeza?')">🗑️</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>
</body>
</html>
