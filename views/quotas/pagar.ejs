<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Pagar Quota</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link active">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Quotas</p>
        <h1 class="page-title">Pagar Quota</h1>
        <p class="page-subtitle">Submeta o pagamento da quota selecionada.</p>
      </div>
      <div class="page-header-actions">
        <a href="/quotas" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card" style="max-width:520px;">
      <div class="card-body">
        <div style="background:var(--clr-bg); border-radius:8px; padding:16px; margin-bottom:24px;">
          <p style="font-size:13px; color:var(--clr-muted); margin-bottom:4px;">Valor da Quota</p>
          <p style="font-size:24px; font-weight:700; color:var(--clr-maroon);"><%= quota.valor %> CVE</p>
          <p style="font-size:12.5px; color:var(--clr-muted);">Periodo: <%= quota.periodo %> | Vencimento: <%= quota.data_vencimento ? new Date(quota.data_vencimento).toLocaleDateString('pt-PT') : '---' %></p>
        </div>
        <form action="/quotas/pagamentos" method="POST">
          <input type="hidden" name="quotaId" value="<%= quota.id %>">
          <input type="hidden" name="valorPago" value="<%= quota.valor %>">
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Metodo de Pagamento</label>
            <select name="metodo" required style="width:100%; padding:10px 14px; border:1px solid var(--clr-border); border-radius:7px; font-size:14px; outline:none; background:white;">
              <option value="transferencia">Transferencia Bancaria</option>
              <option value="mb_way">MB Way</option>
              <option value="numerario">Numerario</option>
              <option value="cartao">Cartao</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">
            Submeter Pagamento
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
