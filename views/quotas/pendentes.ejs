<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Pagamentos Pendentes</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link active">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Quotas</p>
        <h1 class="page-title">Pagamentos Pendentes</h1>
        <p class="page-subtitle">Pagamentos submetidos que aguardam confirmacao.</p>
      </div>
      <div class="page-header-actions">
        <a href="/quotas" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Pagamentos por Confirmar</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= pagamentos.length %> pendentes</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Quota</th>
              <th>Valor Pago</th>
              <th>Metodo</th>
              <th>Data</th>
              <th>Estado</th>
              <th>Acoes</th>
            </tr>
          </thead>
          <tbody>
            <% if (pagamentos.length > 0) { %>
              <% pagamentos.forEach(function(p) { %>
                <tr>
                  <td><strong>#<%= p.quotaId %></strong></td>
                  <td><strong><%= p.valorPago %> CVE</strong></td>
                  <td><%= p.metodo %></td>
                  <td style="font-size:12.5px; color:var(--clr-muted);">
                    <%= p.dataSubmissao ? new Date(p.dataSubmissao).toLocaleDateString('pt-PT') : '---' %>
                  </td>
                  <td><span class="badge badge-amber">Pendente</span></td>
                  <td>
                    <div style="display:flex; gap:6px;">
                      <form action="/quotas/pagamentos/<%= p.id %>/confirmar" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-primary" style="padding:5px 12px; font-size:12px;">Confirmar</button>
                      </form>
                      <form action="/quotas/pagamentos/<%= p.id %>/rejeitar" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-outline" style="padding:5px 12px; font-size:12px; color:var(--clr-red); border-color:var(--clr-red);">Rejeitar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--clr-muted); padding:30px;">
                  Nenhum pagamento pendente
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
