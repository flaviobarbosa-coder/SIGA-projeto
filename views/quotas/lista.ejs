<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Quotas</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
  <style>
    .kpi-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link active">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Financeiro</p>
        <h1 class="page-title">Quotas</h1>
        <p class="page-subtitle">Acompanhe os pagamentos de quotas dos associados.</p>
      </div>
      <div class="page-header-actions">
        <a href="/quotas/pendentes" class="btn btn-outline">Ver Pendentes</a>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi-card green">
        <div class="kpi-top">
          <div class="kpi-icon green"></div>
          <span class="kpi-badge up">Pagas</span>
        </div>
        <p class="kpi-label">Quotas Pagas</p>
        <p class="kpi-value"><%= quotas.filter(function(q){ return q.estado === 'pago'; }).length %></p>
        <p class="kpi-context">Pagamentos confirmados</p>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-top">
          <div class="kpi-icon amber"></div>
          <span class="kpi-badge down">Pendentes</span>
        </div>
        <p class="kpi-label">Em Atraso</p>
        <p class="kpi-value"><%= quotas.filter(function(q){ return q.estado === 'atrasado'; }).length %></p>
        <p class="kpi-context">Requerem atencao</p>
      </div>
      <div class="kpi-card blue">
        <div class="kpi-top">
          <div class="kpi-icon blue"></div>
          <span class="kpi-badge neutral">Total</span>
        </div>
        <p class="kpi-label">Total de Quotas</p>
        <p class="kpi-value"><%= quotas.length %></p>
        <p class="kpi-context">Todos os registos</p>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Registo de Quotas</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= quotas.length %> registos</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Associado</th>
              <th>Periodo</th>
              <th>Valor</th>
              <th>Vencimento</th>
              <th>Estado</th>
              <th>Acao</th>
            </tr>
          </thead>
          <tbody>
            <% if (quotas.length > 0) { %>
              <% quotas.forEach(function(q) { %>
                <tr>
                  <td><strong><%= q.associado_id || '---' %></strong></td>
                  <td><%= q.periodo %></td>
                  <td><strong><%= q.valor %> CVE</strong></td>
                  <td style="font-size:12.5px; color:var(--clr-muted);">
                    <%= q.data_vencimento ? new Date(q.data_vencimento).toLocaleDateString('pt-PT') : '---' %>
                  </td>
                  <td>
                    <% if (q.estado === 'pago') { %>
                      <span class="badge badge-green">Pago</span>
                    <% } else if (q.estado === 'atrasado') { %>
                      <span class="badge badge-amber">Em Atraso</span>
                    <% } else { %>
                      <span class="badge badge-blue">Pendente</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (q.estado !== 'pago') { %>
                      <a href="/quotas/<%= q.id %>/pagar" class="btn btn-primary" style="padding:5px 12px; font-size:12px;">Pagar</a>
                    <% } else { %>
                      <span style="color:var(--clr-muted); font-size:12px;">Pago</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--clr-muted); padding:30px;">
                  Nenhuma quota registada
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
