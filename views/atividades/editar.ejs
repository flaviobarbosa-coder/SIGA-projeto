<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Editar Atividade</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link active">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Atividades</p>
        <h1 class="page-title">Editar Atividade</h1>
        <p class="page-subtitle">Altere os dados da atividade.</p>
      </div>
      <div class="page-header-actions">
        <a href="/atividades" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card" style="max-width:520px;">
      <div class="card-body">
        <form action="/atividades/editar/<%= atividade.id %>" method="POST">
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Nome</label>
            <input type="text" name="nome" value="<%= atividade.nome %>" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Tipo</label>
            <select name="tipo" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; background:white;">
              <option value="conferencia" <%= atividade.tipo === 'conferencia' ? 'selected' : '' %>>Conferencia</option>
              <option value="workshop" <%= atividade.tipo === 'workshop' ? 'selected' : '' %>>Workshop</option>
              <option value="formacao" <%= atividade.tipo === 'formacao' ? 'selected' : '' %>>Formacao</option>
              <option value="transferencia" <%= atividade.tipo === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
            </select>
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Descricao</label>
            <textarea name="descricao" rows="3"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; resize:vertical;"><%= atividade.descricao || '' %></textarea>
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Data</label>
            <input type="date" name="data" value="<%= atividade.data || '' %>" required
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Vagas</label>
            <input type="number" name="vagas" value="<%= atividade.vagas || '' %>" min="1"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none;">
          </div>
          <div style="margin-bottom:24px;">
            <label style="display:block; font-size:13px; font-weight:600; margin-bottom:6px;">Estado</label>
            <select name="estado"
              style="width:100%; padding:9px 12px; border:1px solid var(--clr-border); border-radius:7px; font-size:13.5px; outline:none; background:white;">
              <option value="programada" <%= atividade.estado === 'programada' ? 'selected' : '' %>>Programada</option>
              <option value="em_curso" <%= atividade.estado === 'em_curso' ? 'selected' : '' %>>Em Curso</option>
              <option value="concluida" <%= atividade.estado === 'concluida' ? 'selected' : '' %>>Concluida</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">
            Guardar Alteracoes
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
