<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Atividades</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
  <style>
    .kpi-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link active">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Agenda</p>
        <h1 class="page-title">Atividades</h1>
        <p class="page-subtitle">Eventos, reunioes e iniciativas da associacao.</p>
      </div>
      <div class="page-header-actions">
        <a href="/atividades/criar" class="btn btn-primary">+ Nova Atividade</a>
      </div>
    </div>
    <div class="kpi-grid">
      <div class="kpi-card blue">
        <div class="kpi-top">
          <div class="kpi-icon blue"></div>
          <span class="kpi-badge neutral"><%= atividades.length %> total</span>
        </div>
        <p class="kpi-label">Atividades Agendadas</p>
        <p class="kpi-value"><%= atividades.filter(function(a){ return a.estado === 'programada'; }).length %></p>
        <p class="kpi-context">Por realizar</p>
      </div>
      <div class="kpi-card green">
        <div class="kpi-top">
          <div class="kpi-icon green"></div>
          <span class="kpi-badge up">Em curso</span>
        </div>
        <p class="kpi-label">Em Curso</p>
        <p class="kpi-value"><%= atividades.filter(function(a){ return a.estado === 'em_curso'; }).length %></p>
        <p class="kpi-context">A decorrer agora</p>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-top">
          <div class="kpi-icon amber"></div>
          <span class="kpi-badge neutral">Concluidas</span>
        </div>
        <p class="kpi-label">Atividades Realizadas</p>
        <p class="kpi-value"><%= atividades.filter(function(a){ return a.estado === 'concluida'; }).length %></p>
        <p class="kpi-context">Ja realizadas</p>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Lista de Atividades</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= atividades.length %> registos</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>Tipo</th>
              <th>Data</th>
              <th>Vagas</th>
              <th>Estado</th>
              <th>Acoes</th>
            </tr>
          </thead>
          <tbody>
            <% if (atividades.length > 0) { %>
              <% atividades.forEach(function(a) { %>
                <tr>
                  <td><strong><%= a.nome || a.titulo %></strong></td>
                  <td><%= a.tipo %></td>
                  <td style="font-size:12.5px; color:var(--clr-muted);">
                    <%= a.data || a.data_atividade ? new Date(a.data || a.data_atividade).toLocaleDateString('pt-PT') : '---' %>
                  </td>
                  <td><%= a.vagas %></td>
                  <td>
                    <% if (a.estado === 'programada') { %>
                      <span class="badge badge-blue">Programada</span>
                    <% } else if (a.estado === 'em_curso') { %>
                      <span class="badge badge-green">Em Curso</span>
                    <% } else if (a.estado === 'concluida') { %>
                      <span class="badge badge-gray">Concluida</span>
                    <% } else { %>
                      <span class="badge badge-gray"><%= a.estado %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap:6px;">
                      <a href="/atividades/editar/<%= a.id || a.id_atividade %>" class="icon-btn">✏️</a>
                      <a href="/atividades/eliminar/<%= a.id || a.id_atividade %>" class="icon-btn" onclick="return confirm('Tens a certeza?')">🗑️</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--clr-muted); padding:30px;">
                  Nenhuma atividade registada
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
