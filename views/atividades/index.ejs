<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Gestao de Atividades</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link">Financeiro</a>
      <a href="/atividades" class="nav-link active">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Gestao</p>
        <h1 class="page-title">Atividades</h1>
        <p class="page-subtitle">Gira as atividades e eventos da associacao.</p>
      </div>
      <div class="page-header-actions">
        <a href="/atividades/criar" class="btn btn-primary">+ Nova Atividade</a>
      </div>
    </div>
    <% if (locals.sucesso && sucesso.length > 0) { %>
      <div style="background:#ECFDF5; color:#2E7D5B; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
        <%= sucesso %>
      </div>
    <% } %>
    <% if (locals.erro && erro.length > 0) { %>
      <div style="background:#FEF2F2; color:#B91C1C; padding:12px 16px; border-radius:7px; margin-bottom:16px; font-size:13.5px;">
        <%= erro %>
      </div>
    <% } %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Lista de Atividades</h2>
        <span style="font-size:13px; color:var(--clr-muted);"><%= atividades.length %> atividades registadas</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>Tipo</th>
              <th>Data</th>
              <th>Vagas</th>
              <th>Estado</th>
              <th>Acoes</th>
            </tr>
          </thead>
          <tbody>
            <% if (atividades.length > 0) { %>
              <% atividades.forEach(function(a) { %>
                <tr>
                  <td><strong><%= a.nome %></strong></td>
                  <td><%= a.tipo || '---' %></td>
                  <td><%= a.data || '---' %></td>
                  <td><%= a.vagas || '---' %></td>
                  <td>
                    <% if (a.estado === 'programada') { %>
                      <span class="badge badge-yellow">Programada</span>
                    <% } else if (a.estado === 'em_curso') { %>
                      <span class="badge badge-green">Em Curso</span>
                    <% } else { %>
                      <span class="badge badge-gray">Concluida</span>
                    <% } %>
                  </td>
                  <td style="display:flex; gap:6px;">
                    <a href="/atividades/editar/<%= a.id %>" class="btn btn-outline" style="font-size:12px; padding:5px 12px;">Editar</a>
                    <a href="/atividades/eliminar/<%= a.id %>" class="btn btn-outline" style="font-size:12px; padding:5px 12px; color:#B91C1C; border-color:#B91C1C;" onclick="return confirm('Tens a certeza?')">Eliminar</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; color:var(--clr-muted); padding:30px;">Nenhuma atividade registada</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
