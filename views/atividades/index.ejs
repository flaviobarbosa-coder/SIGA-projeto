<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<title>SIGA - Atividades</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-4">
<h2>Gestao de Atividades</h2>
<a href="/atividades/criar" class="btn btn-success">+ Nova Atividade</a>
<a href="/auth/logout" class="btn btn-secondary">Sair</a>
<table class="table table-bordered mt-3">
<thead class="table-dark"><tr><th>#</th><th>Nome</th><th>Tipo</th><th>Data</th><th>Vagas</th><th>Estado</th><th>Acoes</th></tr></thead>
<tbody>
<%- atividades.map(function(a) { return "<tr><td>" + a.id + "</td><td>" + a.nome + "</td><td>" + a.tipo + "</td><td>" + a.data + "</td><td>" + a.vagas + "</td><td>" + a.estado + "</td><td><a href=\"/atividades/editar/" + a.id + "\" class=\"btn btn-sm btn-warning\">Editar</a> <a href=\"/atividades/eliminar/" + a.id + "\" class=\"btn btn-sm btn-danger\">Eliminar</a></td></tr>"; }).join("") %>
</tbody>
</table>
</div>
</body>
</html>