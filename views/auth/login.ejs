<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Login</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:var(--clr-bg); margin:0; }
    .login-wrap { display:flex; width:100%; max-width:860px; min-height:500px; border-radius:16px; overflow:hidden; box-shadow:0 8px 40px rgba(0,0,0,0.13); }
    .login-left { background:var(--clr-navy); width:320px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:48px 32px; }
    .login-icon { width:60px; height:60px; background:var(--clr-maroon); border-radius:14px; display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
    .login-icon svg { width:32px; height:32px; color:#fff; }
    .login-left strong { font-family:'Lora',serif; font-size:26px; color:#fff; display:block; margin-bottom:4px; }
    .login-left span { font-size:11px; color:rgba(255,255,255,.4); text-transform:uppercase; letter-spacing:1.5px; display:block; margin-bottom:28px; }
    .login-line { width:36px; height:2px; background:var(--clr-gold); border-radius:2px; margin-bottom:24px; }
    .login-desc { color:rgba(255,255,255,.45); font-size:13px; text-align:center; line-height:1.7; }
    .login-right { flex:1; background:#fff; display:flex; flex-direction:column; justify-content:center; padding:48px 44px; }
    .login-right h2 { font-family:'Lora',serif; font-size:24px; font-weight:600; color:var(--clr-text); margin-bottom:4px; }
    .login-right p { color:var(--clr-muted); font-size:13.5px; margin-bottom:28px; }
    .form-group { margin-bottom:16px; }
    .form-group label { display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:var(--clr-text); }
    .form-group input { width:100%; padding:10px 14px; border:1px solid var(--clr-border); border-radius:7px; font-size:14px; outline:none; background:var(--clr-bg); color:var(--clr-text); box-sizing:border-box; }
    .form-group input:focus { border-color:var(--clr-maroon); background:#fff; }
    .btn-login { width:100%; padding:11px; background:var(--clr-maroon); color:#fff; border:none; border-radius:7px; font-size:14px; font-weight:600; cursor:pointer; margin-top:8px; font-family:'Inter',sans-serif; }
    .btn-login:hover { opacity:.88; }
    .alert-erro { background:#FEF2F2; color:#B91C1C; padding:11px 14px; border-radius:7px; font-size:13px; margin-bottom:16px; border-left:3px solid #B91C1C; }
    .alert-sucesso { background:#ECFDF5; color:#2E7D5B; padding:11px 14px; border-radius:7px; font-size:13px; margin-bottom:16px; border-left:3px solid #2E7D5B; }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-left">
      <div class="login-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <strong>SIGA</strong>
      <span>Gestao de Associados</span>
      <div class="login-line"></div>
      <p class="login-desc">Sistema de Gestao de Associados. Aceda a plataforma com as suas credenciais.</p>
    </div>
    <div class="login-right">
      <h2>Bem-vindo</h2>
      <p>Inicie sessao para continuar</p>
      <% if (erro && erro.length > 0) { %>
        <div class="alert-erro"><%= erro %></div>
      <% } %>
      <% if (sucesso && sucesso.length > 0) { %>
        <div class="alert-sucesso"><%= sucesso %></div>
      <% } %>
      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="exemplo@email.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="A sua password" required>
        </div>
        <button type="submit" class="btn-login">Entrar</button>
      </form>
    </div>
  </div>
</body>
</html>
