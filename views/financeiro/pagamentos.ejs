<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Pagamentos</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link active">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Financeiro</p>
        <h1 class="page-title">Pagamentos</h1>
        <p class="page-subtitle">Consulte e registe pagamentos dos associados.</p>
      </div>
      <div class="page-header-actions">
        <a href="/financeiro/pagamentos/criar" class="btn btn-primary">+ Novo Pagamento</a>
        <a href="/financeiro" class="btn btn-outline">← Voltar</a>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Lista de Pagamentos</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Associado</th>
              <th>Tipo</th>
              <th>Valor</th>
              <th>Data</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof pagamentos !== 'undefined' && pagamentos.length > 0) { %>
              <% pagamentos.forEach(function(p) { %>
                <tr>
                  <td><%= p.associado_id || '---' %></td>
                  <td><%= p.tipo_pagamento || '---' %></td>
                  <td><%= p.valor || 0 %> CVE</td>
                  <td><%= p.data_pagamento || '---' %></td>
                  <td>
                    <% if (p.estado === 'pago') { %>
                      <span class="badge badge-green">Pago</span>
                    <% } else if (p.estado === 'pendente') { %>
                      <span class="badge badge-yellow">Pendente</span>
                    <% } else { %>
                      <span class="badge badge-red">Cancelado</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align:center; color:#888; padding:30px;">Nenhum pagamento registado</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
