<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>SIGA - Financeiro</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark" style="background-color: #8B0000;">
    <div class="container">
      <span class="navbar-brand">SIGA - Controlo Financeiro</span>
      <a href="/auth/logout" class="btn btn-outline-light btn-sm">Sair</a>
    </div>
  </nav>

  <div class="container mt-4">
    <h4 class="mb-4">Emissao de Recibos e Controlo Financeiro</h4>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body text-center">
            <h5>Pagamentos</h5>
            <p class="text-muted">Consultar e registar pagamentos</p>
            <a href="/financeiro/pagamentos" class="btn text-white" style="background-color: #8B0000;">
              Ver Pagamentos
            </a>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-body text-center">
            <h5>Recibos</h5>
            <p class="text-muted">Consultar recibos emitidos</p>
            <a href="/financeiro/recibos" class="btn text-white" style="background-color: #8B0000;">
              Ver Recibos
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
