<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Controlo Financeiro</title>
  <link rel="stylesheet" href="/css/siga-shared.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 21V7l9-4 9 4v14M9 21V12h6v9"/>
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <strong>SIGA</strong>
        <span>Gestao de Associados</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/associados" class="nav-link">Associados</a>
      <a href="/quotas" class="nav-link">Quotas</a>
      <a href="/financeiro" class="nav-link active">Financeiro</a>
      <a href="/atividades" class="nav-link">Atividades</a>
      <a href="/utilizadores" class="nav-link">Utilizadores</a>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout">Sair</a>
    </div>
  </aside>
  <main class="main">
    <div class="page-header">
      <div>
        <p class="page-eyebrow">Financeiro</p>
        <h1 class="page-title">Controlo Financeiro</h1>
        <p class="page-subtitle">Gira pagamentos, recibos e relatorios financeiros.</p>
      </div>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px;">
      <div class="card" style="padding:20px; text-align:center; cursor:pointer;" onclick="location.href='/financeiro/pagamentos'">
        <div style="font-size:2rem; margin-bottom:8px;">💳</div>
        <div style="font-weight:600; font-size:15px;">Pagamentos</div>
        <small style="color:#888;">Ver e confirmar pagamentos</small>
      </div>
      <div class="card" style="padding:20px; text-align:center; cursor:pointer;" onclick="location.href='/financeiro/recibos'">
        <div style="font-size:2rem; margin-bottom:8px;">🧾</div>
        <div style="font-weight:600; font-size:15px;">Recibos</div>
        <small style="color:#888;">Emitir e consultar recibos</small>
      </div>
      <div class="card" style="padding:20px; text-align:center; cursor:pointer;" onclick="location.href='/financeiro/relatorios'">
        <div style="font-size:2rem; margin-bottom:8px;">📊</div>
        <div style="font-weight:600; font-size:15px;">Relatorios</div>
        <small style="color:#888;">Ver relatorios financeiros</small>
      </div>
    </div>
  </main>
</body>
</html>
